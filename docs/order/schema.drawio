<mxfile host="app.diagrams.net">
  <diagram id="orders-business" name="OrderDB">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1250">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" vertex="1" parent="1" value="Order Service / PostgreSQL — бизнес-схема&#xA;Одна позиция на заказ. Таблиц Camunda и истории переходов нет.&#xA;Пунктир: логические ссылки через API, не межбазовые внешние ключи." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f1f5f9;strokeColor=#64748b;">
          <mxGeometry y="20" x="30" height="100" width="1440" as="geometry" />
        </mxCell>
        <mxCell id="orders" vertex="1" parent="1" value="order_service.orders&#xA;────────────────────────────&#xA;id : uuid [PK, NOT NULL]&#xA;buyer_id : uuid [NOT NULL]&#xA;product_id : uuid [NOT NULL]&#xA;quantity : bigint [NOT NULL]&#xA;seller_id : uuid [NULL допустим]&#xA;product_name : text [NULL допустим]&#xA;category_id : uuid [NULL допустим]&#xA;category_name : text [NULL допустим]&#xA;product_description : jsonb [NULL допустим]&#xA;unit_price : numeric [NULL допустим]&#xA;total_price : numeric [NULL допустим]&#xA;delivery_address : text [NULL допустим]&#xA;buyer_account_id : uuid [NULL допустим]&#xA;seller_account_id : uuid [NULL допустим]&#xA;payment_id : uuid [NULL допустим] [UQ]&#xA;refund_id : uuid [NULL допустим] [UQ]&#xA;payout_id : uuid [NULL допустим] [UQ]&#xA;status : text [NOT NULL]&#xA;reservation_status : text [NULL допустим]&#xA;cancellation_reason : text [NULL допустим]&#xA;created_at : timestamptz [NOT NULL]&#xA;updated_at : timestamptz [NOT NULL]&#xA;" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#dcfce7;strokeColor=#64748b;">
          <mxGeometry y="160" x="430" height="740" width="620" as="geometry" />
        </mxCell>
        <mxCell id="catalog" vertex="1" parent="1" value="Catalog Service&#xA;&#xA;product_id → товар&#xA;category_id → категория&#xA;orders.id → reservation.order_id&#xA;&#xA;Название, категория, описание и цена — снимки." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#dbeafe;strokeColor=#64748b;">
          <mxGeometry y="180" x="30" height="230" width="340" as="geometry" />
        </mxCell>
        <mxCell id="user" vertex="1" parent="1" value="User Service / Keycloak&#xA;&#xA;buyer_id → покупатель&#xA;seller_id → продавец&#xA;&#xA;Адрес фиксируется при оформлении.&#xA;Счёт продавца — перед выплатой." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#dbeafe;strokeColor=#64748b;">
          <mxGeometry y="480" x="30" height="240" width="340" as="geometry" />
        </mxCell>
        <mxCell id="payment" vertex="1" parent="1" value="Payment Service&#xA;&#xA;buyer_account_id / seller_account_id&#xA;payment_id / refund_id / payout_id&#xA;&#xA;UUID операций сохраняются до вызова.&#xA;Счёт маркетплейса — в конфигурации." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fef3c7;strokeColor=#64748b;">
          <mxGeometry y="200" x="1090" height="280" width="370" as="geometry" />
        </mxCell>
        <mxCell id="rules" vertex="1" parent="1" value="Основные правила&#xA;&#xA;id задаёт клиент; любой повтор — ошибка.&#xA;quantity неизменно, частичной доставки нет.&#xA;unit_price и total_price записывает приложение.&#xA;Конечные заказы сохраняются.&#xA;reservation_status — подтверждённое состояние.&#xA;NULL не доказывает отсутствие резерва.&#xA;updated_at обновляет приложение." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f1f5f9;strokeColor=#64748b;">
          <mxGeometry y="550" x="1090" height="330" width="370" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle" vertex="1" parent="1" value="Статусы заказа&#xA;CREATED → RESERVED → PAID → IN_DELIVERY → DELIVERED → COMPLETED&#xA;Компенсации: CANCELLING_DELIVERY → CANCELLING_PAYMENT → CANCELLING_RESERVATION (по необходимости)&#xA;Конечная отмена: CANCELLED_BY_BUYER / CANCELLED_BY_SELLER / CANCELLED_BY_SYSTEM&#xA;Резерв: NULL / RESERVED / IN_DELIVERY / COMPLETED / CANCELLED; инициатор отмены: NULL / BUYER / SELLER / SYSTEM&#xA;Точные ограничения и индексы — schema.sql; переходы и ограничения гарантий — README.md." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f1f5f9;strokeColor=#64748b;">
          <mxGeometry y="950" x="30" height="220" width="1430" as="geometry" />
        </mxCell>
        <mxCell source="orders" parent="1" id="link_catalog" target="catalog" edge="1" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;html=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell source="orders" parent="1" id="link_user" target="user" edge="1" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;html=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell source="orders" parent="1" id="link_payment" target="payment" edge="1" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;html=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>